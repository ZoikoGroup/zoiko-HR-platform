server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Compress text responses (the JS/CSS bundle is ~2.4 MB raw).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/css text/plain application/javascript text/javascript application/json image/svg+xml;

    # Matches frontend/vercel.json's rewrite: unknown paths fall back to the
    # SPA shell so client-side routing (react-router-dom) can take over.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Vite fingerprints everything under /assets/, so it can be cached for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Logos / icons in public/ are not fingerprinted: a week, then revalidate.
    location ~* \.(?:svg|png|jpg|jpeg|webp|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=604800";
    }
}
