# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL — required, no default. Must be a postgresql:// URL.
# Works with Neon (remote, keep ?sslmode=require) or a local dev Postgres
# (drop the sslmode query param if the local server has no SSL).
HR_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing — required, no default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HR_SECRET_KEY=
HR_ALGORITHM=HS256
HR_ACCESS_TOKEN_EXPIRE_MINUTES=1440

HR_APP_NAME=Zoiko HR Platform Backend
HR_APP_VERSION=1.0.0
# false in production/staging — true only for local dev (enables /docs,
# create_all-on-boot, and dev-only schema patches). See README "Deploying".
HR_DEBUG=false

# Setup-key that unlocks POST /super-admin/bootstrap. Leave empty to disable
# bootstrap entirely (recommended once the first Super Admin exists).
SUPER_ADMIN_SETUP_KEY=

# Comma-separated list of exact frontend origins allowed to call this API.
# Production: the authenticated platform (app.zoikohr.com) plus the public
# marketing site (zoikohr.com / www.zoikohr.com), whose chat widget calls
# POST /assistant/public/ask. For local dev, use
# http://localhost:5173,http://127.0.0.1:5173 (platform) and
# http://localhost:3000,http://localhost:3001 (zoiko-HR-react) instead.
CORS_ORIGINS=https://app.zoikohr.com,https://zoikohr.com,https://www.zoikohr.com
FRONTEND_URL=https://app.zoikohr.com
# Public URL of this API - emailed reset/invite links point here (/auth/reset-password)
API_BASE_URL=https://api.zoikohr.com

# Organization that owns the public (is_public=True) knowledge content the
# zoikohr.com chat widget answers from. Set by scripts/seed_public_assistant.py.
HR_PUBLIC_ORG_ID=

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Who is told about new Request Pricing submissions (comma separated). Blank = the SMTP_FROM_EMAIL inbox.
SALES_NOTIFY_EMAIL=

# HR chatbot assistant (Groq)
HR_GROQ_API_KEY=
HR_GROQ_MODEL=openai/gpt-oss-120b
HR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Stripe — TEST-MODE-ONLY until Section 17/H2 approvals land (see commercial
# billing standard). Leave empty to disable the Stripe sync entirely.
#   sk_test_...      server-side (sync_plan_to_stripe uses this; if empty, no-op)
#   whsec_...        webhook signature secret
#   pk_test_...      publishable key (frontend card elements / checkout)
HR_STRIPE_SECRET_KEY=
HR_STRIPE_WEBHOOK_SECRET=
HR_STRIPE_PUBLISHABLE_KEY=

# Where uploaded files (HR documents, onboarding docs, assistant attachments)
# are written. MUST be a persistent, mounted volume in any real deployment —
# there is no S3/object-storage integration, so this directory is the only
# copy of every uploaded file.
UPLOAD_BASE_DIR=/data/uploads

# ── Entitlement enforcement (ZHR-COM-ENT-001) ───────────────────────────────
# Global on/off switch. Report-only sweep always runs regardless.
HR_ENFORCE_ENTITLEMENTS=true
# Staged rollout, axis 1: comma-separated feature keys to hard-enforce.
# Empty = enforce every mapped key once HR_ENFORCE_ENTITLEMENTS is true.
HR_ENTITLEMENTS_ENFORCE_KEYS=
# Staged rollout, axis 2: comma-separated organization IDs to hard-enforce.
# This only SEEDS the live, DB-editable value on first boot — after that,
# edit it via PUT /super-admin/platform-settings/entitlement_staged_org_ids
# instead of changing this env var (see the runbook in entitlement_middleware.py).
HR_ENTITLEMENTS_ENFORCE_ORG_IDS=
# READ_ONLY treats GET/HEAD as allowed (Section 14.1); set false to block reads too.
HR_ENTITLEMENTS_ALLOW_READ_IN_READ_ONLY=true

# Entitlement decision cache backend. Empty = process-local in-memory cache
# (fine for one instance only). Set before running more than one worker/
# container, or a plan change on one instance won't invalidate another's
# stale cached decision. Local dev: docker compose already runs a redis
# service at this address.
HR_REDIS_URL=redis://localhost:6379/0

# ── Added for production performance / email (see .env.production for the full production template) ──
# Environment name; anything other than development/test keeps dev-only schema patches off.
ENVIRONMENT=production
# DB pool PER worker process (total = workers x (size + overflow); stay under the DB's connection limit).
HR_DB_POOL_SIZE=5
HR_DB_MAX_OVERFLOW=10
HR_DB_POOL_TIMEOUT=30
HR_DB_CONNECT_TIMEOUT=30
# Recycle pooled conns every 300s (Neon closes idle connections ~5min); pool_pre_ping
# on every checkout already catches dead sockets, keepalives catch silent middlebox drops.
HR_DB_POOL_RECYCLE=300
HR_DB_KEEPALIVE_IDLE=60
# Neon only: route through the PgBouncer-compatible "-pooler" host once
# workers x pool exceeds the direct-connection limit (HR_DB_CONNECTION_LIMIT).
# HR_USE_NEON_POOLER=true
# HR_DB_CONNECTION_LIMIT=25
# Worker processes for the Docker image (default 2). Only one runs the scheduled jobs.
# WEB_CONCURRENCY=2
# App-side read of the worker count (accepts HR_WEB_CONCURRENCY or the plain
# WEB_CONCURRENCY the image already exports). Drives the org-access cache TTL:
# 30s single worker, 5s multi-worker without Redis.
HR_WEB_CONCURRENCY=1
# on | off | auto — which process runs the scheduled jobs and webhook worker.
HR_BACKGROUND_JOBS=auto
# IPs/CIDRs of the reverse proxy so audit logs show the real client address.
HR_TRUSTED_PROXIES=
# Email logo/favicon base (blank = {FRONTEND_URL}/email when public https, else https://app.zoikohr.com/email).
HR_EMAIL_ASSET_BASE_URL=
HR_EMAIL_INLINE_LOGO=false
HR_EMAIL_SUPPORT_URL=https://zoikohr.com/contact

# Sign in with Google: create an OAuth client (Web application) in Google Cloud Console and register
# {API_BASE_URL}/auth/google/callback as an authorized redirect URI. Leave blank to switch the button off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the redirect address registered in Google differs from {API_BASE_URL}/auth/google/callback:
# GOOGLE_REDIRECT_URI=

# ── Per-request query instrumentation (dev/ops) ─────────────────────────────
# True = every request is counted/timed (queries, db_ms, pool checkouts + slowest
# statement in the log; X-Query-Count / X-DB-Time headers set on responses). Keep
# false in production unless you are debugging latency — every log line costs a
# little and every query pays one attribute-read when disabled.
HR_LOG_QUERY_STATS=false
# True = additionally log every statement (SQL truncated to 200 chars, no bound
# values) per request for N+1 hunting.
HR_LOG_QUERY_SQL=false
