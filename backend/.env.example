# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL (Neon) — required, no default. Must be a postgresql:// URL.
HR_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing — required, no default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HR_SECRET_KEY=
HR_ALGORITHM=HS256
HR_ACCESS_TOKEN_EXPIRE_MINUTES=1440

HR_APP_NAME=Zoiko HR Platform Backend
HR_APP_VERSION=1.0.0
# false in production/staging — true only for local dev (enables /docs,
# create_all-on-boot, and dev-only schema patches). See README "Deploying".
HR_DEBUG=false

# Setup-key that unlocks POST /super-admin/bootstrap. Leave empty to disable
# bootstrap entirely (recommended once the first Super Admin exists).
SUPER_ADMIN_SETUP_KEY=

# Comma-separated list of exact frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# HR chatbot assistant (Groq)
HR_GROQ_API_KEY=
HR_GROQ_MODEL=openai/gpt-oss-120b
HR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where uploaded files (HR documents, onboarding docs, assistant attachments)
# are written. MUST be a persistent, mounted volume in any real deployment —
# there is no S3/object-storage integration, so this directory is the only
# copy of every uploaded file.
UPLOAD_BASE_DIR=/data/uploads
