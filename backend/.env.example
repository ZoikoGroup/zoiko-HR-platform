# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (Neon) ONLY — required. The backend refuses to start without it.
# Paste your Neon connection string, e.g.:
#   postgresql://user:password@ep-xxx-aws.neon.tech/neondb?sslmode=require
HR_DATABASE_URL=postgresql://user:password@ep-xxx-aws.neon.tech/neondb?sslmode=require

# ── JWT / Auth (own namespace — never reuse the monolith's secret) ──────────
HR_SECRET_KEY=change-me-to-a-long-random-string
HR_ALGORITHM=HS256
HR_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ─────────────────────────────────────────────────────────────────────
HR_APP_NAME=Zoiko HR Platform Backend
HR_DEBUG=true

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ── Super Admin bootstrap ───────────────────────────────────────────────────
# Secret that unlocks POST /super-admin/bootstrap and scripts/seed_super_admin.py.
# Leave empty to disable both.
SUPER_ADMIN_SETUP_KEY=

# ── Email / SMTP (optional — used for invite/password-reset emails) ─────────
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=Info@zoikoone.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Info@zoikoone.com
SMTP_USE_TLS=true
