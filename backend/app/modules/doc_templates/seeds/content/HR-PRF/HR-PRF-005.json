  "blocks": [
    {
      "type": "letterhead",
      "id": "letterhead"
    },
    {
      "type": "paragraph",
      "text": "Private and confidential",
      "style": "notice"
    },
    {
      "type": "heading",
      "text": "Outcome of your probation period",
      "level": 1
    },
    {
      "type": "paragraph",
      "text": "Dear {{worker.first_name}}, thank you for attending the probation review meeting on {{probation.final_meeting_date}}, where we discussed your performance against the objectives set for your probation."
    },
    {
      "type": "heading",
      "text": "Decision",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "After considering the information discussed, including your comments, we have decided not to confirm your employment. {{probation.decision_reasons}}"
    },
    {
      "type": "clause",
      "key": "probation_termination_notice",
      "required": true
    },
    {
      "type": "paragraph",
      "text": "Arrangements for your final pay, any holiday entitlement and the return of company property will be confirmed separately through our normal processes."
    },
    {
      "type": "clause",
      "key": "appeal_rights",
      "required": true
    },
    {
      "type": "paragraph",
      "text": "If you would like support, you can contact {{policy.eap_contact}}.",
      "include_when": {
        "field": "policy.eap_contact",
        "op": "present"
      }
    },
    {
      "type": "signature_block",
      "parties": [
        "employer"
      ]
    }
  ],
