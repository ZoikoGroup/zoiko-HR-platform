{
  "canonical_id": "HR-PRF-002",
  "output_mode": "FORM_RECORD",
  "execution_mode": "ACKNOWLEDGE",
  "audience": "EMPLOYEE",
  "approval_policy": "L1",
  "field_contract": {
    "required": [
      "worker.full_name",
      "probation.review_number",
      "probation.review_date",
      "probation.reviewer",
      "probation.recommendation_label"
    ],
    "optional": [
      "employment.position_title",
      "employment.manager_name",
      "probation.end_date",
      "probation.objectives_progress",
      "probation.strengths",
      "probation.concerns",
      "probation.support_agreed"
    ]
  },
  "clause_rules": {
    "mandatory": [],
    "optional": [],
    "prohibited": []
  },
  "blocks": [
    {
      "type": "heading",
      "text": "Probation Review {{probation.review_number}} — {{worker.full_name}}",
      "level": 1
    },
    {
      "type": "field_group",
      "fields": [
        "employment.position_title",
        "employment.manager_name",
        "probation.review_date",
        "probation.end_date"
      ],
      "labels": {
        "employment.position_title": "Role",
        "employment.manager_name": "Manager",
        "probation.end_date": "Probation ends"
      }
    },
    {
      "type": "table",
      "columns": [
        "Objective",
        "Progress",
        "Evidence"
      ],
      "rows_from": "probation.objectives_progress",
      "include_when": {
        "field": "probation.objectives_progress",
        "op": "present"
      }
    },
    {
      "type": "heading",
      "text": "What is going well",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "{{probation.strengths}}",
      "include_when": {
        "field": "probation.strengths",
        "op": "present"
      }
    },
    {
      "type": "heading",
      "text": "Areas to improve",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "{{probation.concerns}}",
      "include_when": {
        "field": "probation.concerns",
        "op": "present"
      }
    },
    {
      "type": "paragraph",
      "text": "Concerns must be specific, with examples, and the support offered.",
      "style": "small"
    },
    {
      "type": "heading",
      "text": "Support agreed",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "{{probation.support_agreed}}",
      "include_when": {
        "field": "probation.support_agreed",
        "op": "present"
      }
    },
    {
      "type": "heading",
      "text": "Your comments",
      "level": 2
    },
    {
      "type": "form_fields",
      "id": "employee_comments",
      "fields": [
        {
          "key": "employee_comments",
          "label": "Your comments",
          "type": "textarea"
        }
      ]
    },
    {
      "type": "field_group",
      "fields": [
        "probation.recommendation_label"
      ],
      "labels": {
        "probation.recommendation_label": "Recommendation"
      }
    },
    {
      "type": "paragraph",
      "text": "This review records progress at this point in your probation. A recommendation is not a final decision. You can add your comments and ask questions before any decision is made.",
      "id": "rights_probation_review"
    },
    {
      "type": "declaration",
      "text": "I have read this review. My acknowledgement does not mean I agree with everything in it.",
      "mode": "acknowledge",
      "id": "declaration"
    }
  ],
  "locked_block_ids": [],
  "email_attachment_allowed": false,
  "reminder_days": [],
  "response_days": null
}
