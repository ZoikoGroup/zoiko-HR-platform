{
  "canonical_id": "HR-HIR-016",
  "output_mode": "DOCUMENT",
  "execution_mode": "SIGN_CANDIDATE",
  "audience": "CANDIDATE",
  "approval_policy": "L2",
  "field_contract": {
    "required": [
      "candidate.first_name",
      "candidate.full_name",
      "employer.legal_name",
      "employment.position_title",
      "employment.employment_type_label",
      "employment.start_date",
      "offer.reference",
      "offer.pay_amount",
      "offer.currency",
      "offer.pay_period_label",
      "offer.response_deadline",
      "employer.hr_contact_email",
      "offer.hours_per_week"
    ],
    "optional": [
      "candidate.postal_address",
      "employment.department",
      "employment.manager_name",
      "employment.work_location",
      "employment.work_country_name",
      "employment.work_pattern",
      "offer.work_arrangement_label",
      "offer.remuneration_type_label",
      "offer.components",
      "offer.equity",
      "offer.benefits_summary",
      "offer.conditions",
      "employer.hr_contact_name",
      "document.date",
      "employer.signatory_name"
    ]
  },
  "clause_rules": {
    "mandatory": [
      "part_time_equal_treatment",
      "offer_statutory_statement",
      "offer_conditions_explainer"
    ],
    "optional": [],
    "prohibited": []
  },
  "blocks": [
    {
      "type": "letterhead",
      "id": "letterhead"
    },
    {
      "type": "paragraph",
      "text": "{{document.date}} · Private and confidential · Reference {{offer.reference}}"
    },
    {
      "type": "paragraph",
      "text": "{{candidate.full_name}}, {{candidate.postal_address}}"
    },
    {
      "type": "heading",
      "text": "Part-time offer of employment",
      "level": 1
    },
    {
      "type": "paragraph",
      "text": "Dear {{candidate.first_name}}, we are pleased to offer you the part-time position of {{employment.position_title}} at {{employer.legal_name}}."
    },
    {
      "type": "heading",
      "text": "Main terms",
      "level": 2
    },
    {
      "type": "field_group",
      "fields": [
        "employment.position_title",
        "employment.department",
        "employment.manager_name",
        "employment.employment_type_label",
        "employment.start_date",
        "employment.work_location",
        "employment.work_country_name",
        "offer.work_arrangement_label",
        "employment.work_pattern"
      ],
      "labels": {
        "employment.manager_name": "Reporting to",
        "employment.start_date": "Proposed start date",
        "offer.work_arrangement_label": "Working arrangement",
        "employment.work_pattern": "Working pattern"
      }
    },
    {
      "type": "paragraph",
      "text": "Pay: {{offer.pay_amount}} {{offer.currency}} {{offer.pay_period_label}} ({{offer.remuneration_type_label}})."
    },
    {
      "type": "table",
      "columns": [
        "Component",
        "Amount",
        "Frequency"
      ],
      "rows_from": "offer.components",
      "include_when": {
        "field": "offer.components",
        "op": "present"
      }
    },
    {
      "type": "paragraph",
      "text": "Equity: {{offer.equity}}, subject to the terms of the applicable plan documents.",
      "include_when": {
        "field": "offer.equity",
        "op": "present"
      }
    },
    {
      "type": "paragraph",
      "text": "Benefits: {{offer.benefits_summary}}",
      "include_when": {
        "field": "offer.benefits_summary",
        "op": "present"
      }
    },
    {
      "type": "paragraph",
      "text": "Contracted hours: {{offer.hours_per_week}} hours per week."
    },
    {
      "type": "clause",
      "key": "part_time_equal_treatment",
      "required": true
    },
    {
      "type": "heading",
      "text": "Conditions of this offer",
      "level": 2,
      "include_when": {
        "field": "offer.conditions",
        "op": "present"
      }
    },
    {
      "type": "list",
      "style": "bullet",
      "items_from": "offer.conditions",
      "include_when": {
        "field": "offer.conditions",
        "op": "present"
      }
    },
    {
      "type": "clause",
      "key": "offer_conditions_explainer",
      "required": true,
      "include_when": {
        "field": "offer.conditions",
        "op": "present"
      }
    },
    {
      "type": "heading",
      "text": "Next steps",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Please review this offer and accept or decline it using the secure link by {{offer.response_deadline}}. If you have questions, contact {{employer.hr_contact_name}} at {{employer.hr_contact_email}}."
    },
    {
      "type": "clause",
      "key": "offer_statutory_statement",
      "required": true
    },
    {
      "type": "paragraph",
      "text": "We look forward to welcoming you."
    },
    {
      "type": "signature_block",
      "parties": [
        "employer",
        "candidate"
      ]
    },
    {
      "type": "declaration",
      "text": "I accept this part-time offer of employment on the terms set out above.",
      "mode": "sign",
      "id": "declaration"
    }
  ],
  "locked_block_ids": [],
  "email_attachment_allowed": false,
  "reminder_days": [
    3,
    1
  ],
  "response_days": 7
}
