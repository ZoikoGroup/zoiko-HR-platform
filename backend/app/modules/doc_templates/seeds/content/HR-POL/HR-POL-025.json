      "policy.effective_from",
      "policy.owner_name",
      "policy.contact",
      "org.display_name",
      "policy.leave_year_label",
      "policy.annual_leave_notice_days"
    ],
    "optional": [
      "policy.review_due",
      "policy.scope_statement",
      "policy.change_summary",
      "employer.legal_name"
    ]
  },
  "clause_rules": {
    "mandatory": [
      "statutory_annual_leave",
      "annual_leave_carry_over",
      "leave_on_termination"
    ],
    "optional": [
      "sickness_during_leave"
    ],
    "prohibited": []
  },
  "blocks": [
    {
      "type": "heading",
      "text": "{{policy.title}}",
      "level": 1
    },
    {
      "type": "field_group",
      "fields": [
        "policy.owner_name",
        "policy.version",
        "policy.effective_from",
        "policy.review_due",
        "policy.scope_statement"
      ],
      "labels": {
        "policy.owner_name": "Policy owner",
        "policy.version": "Version",
        "policy.effective_from": "Effective from",
        "policy.review_due": "Next review",
        "policy.scope_statement": "Applies to"
      }
    },
    {
      "type": "paragraph",
      "text": "What changed in this version: {{policy.change_summary}}",
      "include_when": {
        "field": "policy.change_summary",
        "op": "present"
      },
      "style": "notice"
    },
    {
      "type": "heading",
      "text": "1. Purpose",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "This policy explains how annual leave is requested, approved and recorded."
    },
    {
      "type": "heading",
      "text": "2. Entitlement",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Your annual leave entitlement is set out in your contract and shown in your leave balance in ESS."
    },
    {
      "type": "clause",
      "key": "statutory_annual_leave",
      "required": true
    },
    {
      "type": "heading",
      "text": "3. Leave year",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "The leave year is {{policy.leave_year_label}}."
    },
    {
      "type": "heading",
      "text": "4. Requesting leave",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Request leave in ESS at least {{policy.annual_leave_notice_days}} days ahead. Every decision is recorded and you can see it with your request."
    },
    {
      "type": "heading",
      "text": "5. How decisions are made",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "We consider business cover and a fair rota, and decide on a first-come basis where requests clash. If a request is refused, we give the reason and suggest alternatives."
    },
    {
      "type": "heading",
      "text": "6. Carry-over",
      "level": 2
    },
    {
      "type": "clause",
      "key": "annual_leave_carry_over",
      "required": true
    },
    {
      "type": "heading",
      "text": "7. Public holidays",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Public holidays follow the holiday calendar for your work location."
    },
    {
      "type": "heading",
      "text": "8. Sickness during leave",
      "level": 2
    },
    {
      "type": "clause",
      "key": "sickness_during_leave",
      "required": false
    },
    {
      "type": "heading",
      "text": "9. Leave on leaving",
      "level": 2
    },
    {
      "type": "clause",
      "key": "leave_on_termination",
      "required": true
    },
    {
      "type": "heading",
      "text": "10. Part-time workers",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Part-time workers receive leave on a pro-rata basis."
    },
    {
      "type": "heading",
      "text": "11. Related policies and contact",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Sick Leave Policy; Family and Parental Leave Policy; Working Hours Policy."
    },
    {
      "type": "paragraph",
      "text": "Questions about this policy go to {{policy.contact}}."
    },
    {
      "type": "paragraph",
      "text": "This policy explains how we work. Unless your contract says otherwise, it does not form part of your contract of employment and we may update it from time to time, following any consultation the law requires. Nothing in this policy reduces your rights under the law or any applicable collective agreement.",
      "id": "rights_policy_status"
    },
    {
      "type": "paragraph",
      "text": "If you have questions or concerns about this policy, speak to your manager or {{policy.contact}}. You will not be treated unfairly for raising a genuine concern.",
      "id": "rights_speak_up"
    }
  ],
  "locked_block_ids": [],
  "email_attachment_allowed": false,
  "reminder_days": [
    7,
    1
  ],
  "response_days": 14
}
