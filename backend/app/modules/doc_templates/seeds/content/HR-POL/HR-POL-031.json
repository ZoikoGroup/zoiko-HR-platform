    ],
    "optional": [],
    "prohibited": []
  },
  "blocks": [
    {
      "type": "heading",
      "text": "{{policy.title}}",
      "level": 1
    },
    {
      "type": "field_group",
      "fields": [
        "policy.owner_name",
        "policy.version",
        "policy.effective_from",
        "policy.review_due",
        "policy.scope_statement"
      ],
      "labels": {
        "policy.owner_name": "Policy owner",
        "policy.version": "Version",
        "policy.effective_from": "Effective from",
        "policy.review_due": "Next review",
        "policy.scope_statement": "Applies to"
      }
    },
    {
      "type": "paragraph",
      "text": "What changed in this version: {{policy.change_summary}}",
      "include_when": {
        "field": "policy.change_summary",
        "op": "present"
      },
      "style": "notice"
    },
    {
      "type": "heading",
      "text": "1. Purpose",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "This policy covers the use of company systems, devices, e-mail, internet, software and AI tools."
    },
    {
      "type": "heading",
      "text": "2. Acceptable use",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Company systems are for business use. Limited personal use is allowed if it does not interfere with your work or breach other policies."
    },
    {
      "type": "heading",
      "text": "3. Not allowed",
      "level": 2
    },
    {
      "type": "list",
      "style": "bullet",
      "items": [
        "Illegal, offensive or harassing content.",
        "Sharing your credentials.",
        "Installing unapproved software.",
        "Bypassing security controls.",
        "Copying company data to personal storage.",
        "Using unapproved AI tools with company data."
      ]
    },
    {
      "type": "heading",
      "text": "4. Passwords and multi-factor authentication",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Use strong, unique passwords and multi-factor authentication wherever it is offered. Never share codes."
    },
    {
      "type": "heading",
      "text": "5. E-mail and messaging",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Write as you would in any business communication. Check recipients before sending confidential information."
    },
    {
      "type": "heading",
      "text": "6. Monitoring",
      "level": 2
    },
    {
      "type": "clause",
      "key": "monitoring_notice",
      "required": true
    },
    {
      "type": "heading",
      "text": "7. Reporting incidents and lost devices",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Report security incidents and lost or stolen devices to {{policy.contact}} immediately."
    },
    {
      "type": "heading",
      "text": "8. Breaches",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Breaches may be dealt with under our disciplinary procedure, following a fair process."
    },
    {
      "type": "heading",
      "text": "9. Related policies and contact",
      "level": 2
    },
    {
      "type": "paragraph",
      "text": "Employee Data Protection Policy; Company Property Policy; Remote Work Policy."
    },
    {
      "type": "paragraph",
      "text": "Questions about this policy go to {{policy.contact}}."
    },
    {
      "type": "paragraph",
      "text": "This policy explains how we work. Unless your contract says otherwise, it does not form part of your contract of employment and we may update it from time to time, following any consultation the law requires. Nothing in this policy reduces your rights under the law or any applicable collective agreement.",
      "id": "rights_policy_status"
    },
    {
      "type": "paragraph",
      "text": "If you have questions or concerns about this policy, speak to your manager or {{policy.contact}}. You will not be treated unfairly for raising a genuine concern.",
      "id": "rights_speak_up"
    }
  ],
  "locked_block_ids": [],
  "email_attachment_allowed": false,
  "reminder_days": [
    7,
    1
  ],
  "response_days": 14
}
